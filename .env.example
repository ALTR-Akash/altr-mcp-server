# Required — server will not start without these
ORG_ID=your-org-id
MAPI_KEY=your-api-key
MAPI_SECRET=your-api-secret

# Optional — transport (default: stdio)
# MCP_TRANSPORT=stdio          # stdio | sse | streamable-http
# MCP_HOST=0.0.0.0             # bind address for sse / streamable-http
# MCP_PORT=8000                # port for sse / streamable-http

# Optional — restrict which tools are exposed to MCP clients
#   Comma-separated tool names. Restricted tools are hidden from
#   tools/list and rejected on tools/call. Names must match exactly;
#   an entry matching no registered tool restricts nothing, and is
#   logged as a warning (at LOG_LEVEL <= WARNING) the first time a
#   client lists tools. The database, tag, repo, and sidecar teardown
#   tools are named disconnect_*, not delete_*.
# RESTRICTED_TOOLS=disconnect_database,disconnect_tag,delete_policy,delete_rule

# Optional — expose only the 71 read-only tools (72 on stdio, counting an
#   inert enter_support_mode), for support and field engineering
#   investigations. Also appends support operating instructions to the
#   server instructions. Set here, it is a hard mode: no tool can unlock
#   a write or leave it, only a restart can.
#   To arm the same enforcement without editing this file, call the
#   enter_support_mode tool instead. See docs/support-mode.md.
# SUPPORT_MODE=false

# Optional — publish the eight troubleshooting prompts over
#   prompts/list. Off by default: a published prompt appears in every
#   user's prompt menu as soon as they upgrade, so it is opted into
#   rather than inherited from a version bump.
# SUPPORT_PROMPTS=false

# Optional — logging
# LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=console           # console | json

# Optional — HTTP retry behavior for transient 429/5xx errors
#   MAX_RETRIES counts total attempts, so 1 means "never retry".
#   MAX_RETRY_AFTER caps a server-sent Retry-After header.
# MAX_RETRIES=3
# DISABLE_RETRY=false
# MAX_RETRY_AFTER=60

# Optional — per-request timeout in seconds (connect, read, write, pool)
# REQUEST_TIMEOUT=30

# Optional — override base URLs (default to ALTR production)
# ALTR_API_BASE_URL=https://api.live.altr.com
# ALTR_ALTRNET_BASE_URL=https://altrnet.live.altr.com
# ALTR_CLASSIFICATION_BASE_URL=https://{ORG_ID}.classification.live.altr.com
# ALTR_SC_CONTROL_BASE_URL=https://{ORG_ID}.sc-control.live.altr.com
# ALTR_SERVICE_USER_BASE_URL=https://{ORG_ID}.service-user.live.altr.com
# ALTR_AUDIT_REPORT_BASE_URL=https://{ORG_ID}.audit-report.live.altr.com/v1
# ALTR_VAULT_BASE_URL=https://{ORG_ID}.vault.live.altr.com/api/v2
# ALTR_CRITICAL_BASE_URL=https://{ORG_ID}.critical.live.altr.com/v2
# ALTR_KMA_BASE_URL=https://{ORG_ID}.kma.live.altr.com/v1
# ALTR_DAM_ALERTING_BASE_URL=https://{ORG_ID}.dam-alerting.live.altr.com/v1/dam-alerting
